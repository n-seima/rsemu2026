		if(m_wPieceCount != _lpPieceItem->m_wPieceCount)
			return 0;
		
		if(!m_item.isSame(&_lpPieceItem->m_item))
			return 0;
		
		if(m_bf1IsSetItem != _lpPieceItem->m_bf1IsSetItem)
			return 0;
		
		if(m_bf11SetGroupIndex != _lpPieceItem->m_bf11SetGroupIndex)
