		m_dwPhysicalDamage	=	_iPhysicalDamage;		
		m_dwMagicDamage		=	_iMagicDamage;			
		m_dwResultField		=	_dwResult;			
		if(_lpContinuousHitInfo)
		{
			memcpy(&continuousHitInfo,_lpContinuousHitInfo, sizeof(CContinuousHitInfo));
		}
	}
	inline	void	copy(CHitInfo *_lpInfo)
	{
		m_dwPhysicalDamage	=	_lpInfo->m_dwPhysicalDamage;		
		m_dwMagicDamage		=	_lpInfo->m_dwMagicDamage;		
		m_dwResultField		=	_lpInfo->m_dwResultField;		
		continuousHitInfo	=	_lpInfo->continuousHitInfo;
	}

	inline	int		getDamage()				{return	m_dwPhysicalDamage+m_dwMagicDamage;}

	inline	void	setHit()				{m_dwResultField|=0x00000001;}
	inline	void	setCritical()			{m_dwResultField|=0x00000002;}
	inline	void	setCrush()				{m_dwResultField|=0x00000004;}
	inline	void	setBlock()				{m_dwResultField|=0x00000008;}
	inline	void	setNoActionBlock()		{m_dwResultField|=0x00002000;}
	inline	void	setDancingBlockerBlock(){m_dwResultField|=0x00004000;}
	inline	void	setHitAction()			{m_dwResultField|=0x00000010;}
	inline	void	setInstanceKill()		{m_dwResultField|=0x00000020;}
	inline	void	setPhysicalDamage()		{m_dwResultField|=0x00000040;}
	inline	void	setDodge()				{m_dwResultField|=0x00008000			;}
	inline	void	setLuckyDoubleCritical(){m_dwResultField|=0x00000100;}
	inline	void	setAttackToShakle()
	{
		if	(m_dwResultField == 0xffffffff )	
			m_dwResultField	=	0;
		m_dwResultField	|=	0x00080000;
	}
	inline	void	setHardBlow()			{m_dwResultField|=0x00400000;}
	inline	void	setIgnoreBlock()			{m_dwResultField|=0x00800000;}
	inline	BOOL	isHit()					{if (m_dwResultField&0x00000001			)	return	1;return	0;}
	inline	BOOL	isMiss()				{if (m_dwResultField&0x00000001			)	return	0;return 1;}
	inline	BOOL	isCritical()			{if (m_dwResultField&0x00000002		)	return	1;return	0;}
	inline	BOOL	isCrush()				{if (m_dwResultField&0x00000004			)	return	1;return	0;}
	inline	BOOL	isBlock()				
	{
		if	(isAttackToShakle())
			return	0;

		if	(m_dwResultField&0x00000008			)
			return	1;
		return	0;
	}
	inline	BOOL	isNoActionBlock()
	{
		if	(m_dwResultField&0x00000020)
			return	0;

		if	(m_dwResultField&0x00002000)
			return	1;

		return	0;
	}
	inline	BOOL	isDancingBlockerBlock()	
	{
		if	(isHitTheOtherSelf())
			return	0;

		if	(m_dwResultField&0x00004000)
			return	1;
		return	0;
	}
	inline	BOOL	isHitAction()			{if (m_dwResultField&0x00000010		)	return	1;return	0;}
	inline	BOOL	isInstanceKill()		
	{
		if	(isReflection() || isInvincible() || isHitTheOtherSelf()	||	isAttackToShakle()	||	isByDamagePool())
			return	0;
		if	(m_dwResultField&0x00000020	)
			return	1;
		return	0;
	}
	inline	BOOL	isPhysicalDamage()		{if (m_dwResultField&0x00000040)	return	1;return	0;}
	inline	BOOL	isDodge()				
	{
		if	(isReflection())
			return	0;

		if (m_dwResultField&0x00008000)
			return	1;

		return	0;
	}
	inline BOOL		isHitFire()
	{
		if (m_dwResultField&0x00200000)
			return	1;
		return	0;
	}
	inline	BOOL	isImmune()				
	{
		if	(m_dwResultField&0x00000020	)
			return	0;

		if	(m_dwResultField&0x00000400				)
			return	1;
		
		return	0;
	}
	inline	BOOL	isInvincible()			{if ((m_dwResultField&0x00010000)	==	0x00010000)	return	1;return	0;}
	inline	BOOL	isHitTheOtherSelf()		{if ((m_dwResultField&0x00040000)	==	0x00040000)	return	1;return	0;}
	inline	BOOL	isReflection()			{if ((m_dwResultField&0x00020000)	==	0x00020000)	return	1;return	0;}
	inline	BOOL	isAttackToShakle()		{if ((m_dwResultField&0x00080000)	==	0x00080000)	return	1;return	0;}
	inline	BOOL	isByDamagePool()		{if ((m_dwResultField&0x00100000	)	==	0x00100000	)	return	1;return	0;}

	inline	BOOL	isLuckyHit()			{if (m_dwResultField&0x00000080			)	return	1;return	0;}
	inline	BOOL	isLuckyDoubleCritical()	{if (m_dwResultField&0x00000100)	return	1;return	0;}
	inline	BOOL	isLuckyDodge()			
	{
		if (isInstanceKill())
			return	0;
		if (m_dwResultField&0x00000200			)	
			return	1;
		return	0;
	}
	inline	BOOL	isLuckyDamage()			{if (m_dwResultField&0x00000800			)	return	1;return	0;}
	inline	BOOL	isLuckyDodgeCritical()	{if (m_dwResultField&0x00001000	)	return	1;return	0;}
	inline BOOL		isHardBlow()
	{
		if (m_dwResultField&0x00400000)
			return	1;
		return	0;
	}
	inline BOOL		isIgnoreBlock()
	{
		if (m_dwResultField&0x00800000)
			return	1;
		return	0;
	}
};	

