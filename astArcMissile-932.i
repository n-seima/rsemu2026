	inline	void			removeItem(int _iSlot,int _iCount)	
	{
		if	(_iSlot	==	0xfffe)	
			m_iGold	-=	_iCount;
		else
		{
			if (_iSlot	>=	100)
			{
				m_aEquip[_iSlot-100].decreaseCount(_iCount);
				buildPower();
			}else if	(_iSlot	>=	42)
				m_aExtraInventory[_iSlot-42].decreaseCount(_iCount);
			else
				m_aItems[_iSlot].decreaseCount(_iCount);
		}
		arrangeInventory();
	}

