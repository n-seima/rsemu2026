		BOOL IsVertical() const { return m_nYRatio > 0; }
		BOOL IsNone() const { return !IsHorizontal() && !IsVertical(); }

		
		
		
		
		int m_nXRatio;

		
		
		
		
		int m_nYRatio;
	};

	
	
	
	struct SizeSettings
	{
		SizeSettings()
		{
			m_nXRatio = 0;
			m_nYRatio = 0;
		}

		BOOL IsHorizontal() const { return m_nXRatio > 0; }
		BOOL IsVertical() const { return m_nYRatio > 0; }
		BOOL IsNone() const { return !IsHorizontal() && !IsVertical(); }

		
		
		
		
		int m_nXRatio;

		
		
		
		
		int m_nYRatio;
	};


