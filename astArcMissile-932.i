class	CGuildBattleSchedule	
{
public:
	WORD						m_wYear,m_wMonth,m_wDay;

	CGuildBattleInField			m_aBattleGuildSchedule[23];

	void						setDate(int _iYear,int _iMonth,int _iDay)	
	{
		m_wYear	=	_iYear;
		m_wMonth=	_iMonth;
		m_wDay	=	_iDay;
	}
	
	DWORD						getCheckSum()
	{
		DWORD	dwCheckSum	=	0;

		dwCheckSum	+=	m_wYear;
		dwCheckSum	+=	m_wMonth;
		dwCheckSum	+=	m_wDay;

		for (int i=0;i<23;i++)
		{
			for (int j=0;j<10;j++)
			{
				dwCheckSum	+=	m_aBattleGuildSchedule[i].m_aBattleGuildInfo[j].m_awBattleGuild[0];
				dwCheckSum	+=	m_aBattleGuildSchedule[i].m_aBattleGuildInfo[j].m_awBattleGuild[1];
				dwCheckSum	+=	m_aBattleGuildSchedule[i].m_aBattleGuildInfo[j].m_wFieldSerial;
			}
		}

		return	dwCheckSum;
	}
};



