	inline	void			regenHP()	
	{
		if (m_regenHPPerSecond.getCorrectedValue()	==	0)
			return;

		if (m_iHP	>=	getMaxHP())
			return;

		int	iRecoverHP	=	(m_regenHPPerSecond.getCorrectedValue()/64+1);

		m_iHP	+=	iRecoverHP;
		m_iHP	=	(((m_iHP) < (getMaxHP())) ? (m_iHP) : (getMaxHP()));
	}



