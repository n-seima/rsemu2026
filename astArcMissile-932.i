class	cPLAYER_STATUS
{
public:
	
	
	class	cACTOR_FACTOR_TYPE1
	{
	public:
		short	m_sValue;		
		short	m_sFixValue;

		short	m_sCorrectValue;
		WORD	m_wTime;		
		WORD	m_bf1IsCanNotApplySameEffect	:	1;	
		WORD	:0;

		inline	BOOL	isWrong()
		{
			if (m_sCorrectValue				<	0)	return	1;					

			return	0;
		}

		inline	void	cure()
		{
			if (m_sCorrectValue	<	0)	m_sCorrectValue			=	0;
		}

		inline	BOOL	decreaseTime()	
		{
			if (m_wTime	==	0)	return 0;

			m_wTime--;
			if (m_wTime	==	0)
			{
				m_sCorrectValue	=	0;
				m_bf1IsCanNotApplySameEffect	=	0;
				return	1;
			}
			return	0;
		}

		inline	void	resetAidData()
		{
			m_sCorrectValue	=	0;	
			m_wTime			=	0;	
		}

		inline	void	resetEquipmentValue()	
		{
			m_sValue		=	0;	
			m_sFixValue		=	0x7fff;
		}

		inline	void	correctValue(int _iValue,int _iTime, BOOL _bIsCanNotApplySameEffect = 0)
		{

			if(m_bf1IsCanNotApplySameEffect)
			{
				if( _iValue > 0 && m_sCorrectValue > 0 )
					return;
				
				if( _iValue < 0 && m_sCorrectValue < 0 )
					return;
			}
			
