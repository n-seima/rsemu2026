	static	inline	void	ResetAllFocus()
	{
		s_iFocusActor		=	0xffff;
		s_iFocusArea		=	0xffff;
		s_iFocusItem		=	0xffff;
		s_iFocusSkill		=	0xffff;
		s_iFocusFieldItem	=	0xffff;
		s_iFocusBeltSlot	=	0xffff;
		s_iFocusTrap		=	0xffff;
	}

	static	inline	BOOL	IsValidFocus()	
	{
		if (s_iFocusActor		!=	0xffff)	return	0;
		if (s_iFocusArea		!=	0xffff)	return	0;
		if (s_iFocusItem		!=	0xffff)	return	0;
		if (s_iFocusSkill		!=	0xffff)	return	0;
		if (s_iFocusFieldItem	!=	0xffff)	return	0;
		if (s_iFocusTrap		!=	0xffff)	return	0;

		return	1;
	}

	static	inline	BOOL	IsExclusiveFocus()	
	{
		if (s_iFocusActor		!=	0xffff)	return	1;
		if (s_iFocusArea		!=	0xffff)	return	1;
		if (s_iFocusItem		!=	0xffff)	return	1;
		if (s_iFocusSkill		!=	0xffff)	return	1;
		if (s_iFocusFieldItem	!=	0xffff)	return	1;
		if (s_iFocusTrap		!=	0xffff)	return	1;

		return	0;
	}

	static	inline	void	PushFocusArea()
	{
		s_iFocusAreaStack	=	s_iFocusArea;
		s_iFocusArea		=	0xffff;
	}

	static	inline	void	PopFocusArea()
	{
		if (IsValidFocus())
			s_iFocusArea		=	s_iFocusAreaStack;
	}
};

