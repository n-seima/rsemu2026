	inline	cItem		*getWeapon(BOOL _bIsCheckVisible=0)	
	{
		if	(_bIsCheckVisible && (!c_aUseWeaponJob[m_wJob] || m_wJob	>=	20))
			return	0;

		int	iPart	=	0;

		if	(m_wJob%2	&&	m_wJob	!=	11)
			iPart	=	dEQUIP_WEAPON_2;

		if	(iPart == 0	&& m_bf1IsHideWeapon1)	
			return	0;
		if	(iPart == dEQUIP_WEAPON_2&& m_bf1IsHideWeapon2)	
			return	0;

		if	(m_aEquip[iPart].m_wBaseItem	!=	0xffff)	
			return	&m_aEquip[iPart];

		return	0;
	}

	inline	cItem			*getOtherJobWeapon()
	{
		if	(m_wJob	>=	20)
			return	0;

		int	iJob	=	m_wJob;
		int	iPart	=	0;

		if (iJob%2)
			iJob--;
		else
			iJob++;
		
		if	(!c_aUseWeaponJob[iJob])
			return	0;

		if	(iJob%2	&&	iJob	!=	11)
			iPart	=	dEQUIP_WEAPON_2;

		if	(iPart == 0	&& m_bf1IsHideWeapon1)
			return	0;
		if	(iPart == dEQUIP_WEAPON_2&& m_bf1IsHideWeapon2)
			return	0;

		if	(m_aEquip[iPart].m_wBaseItem	!=	0xffff)	
			return	&m_aEquip[iPart];

		return	0;
	}

