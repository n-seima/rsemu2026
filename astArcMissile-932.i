inline	int
CActor::getRange(CActor *_lpActor,int _iAddLength)
{
	int	xs	=	m_pos.x	-	_lpActor->m_pos.x;
	int	ys	=	m_pos.y	-	_lpActor->m_pos.y;

	if (xs < 0 ) xs = -xs;
	if (ys < 0 ) ys = -ys;

	ys	*=	2;
	xs += _iAddLength;
	ys += _iAddLength;

	if (xs >= 0xafff)	return	0x7ffffff;
	if (ys >= 0xafff)	return	0x7ffffff;

	return	(xs*xs+ys*ys);
}




