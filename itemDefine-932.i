class CAnimationVariableChangeHandler : public CUIAnimationVariableChangeHandlerBase<CAnimationVariableChangeHandler>
{
	CAnimationController* m_pAnimationController;

public:
	
	
	
	CAnimationVariableChangeHandler() : m_pAnimationController(0)
	{
	}

	
	
	
	
	
	
	
	
	
	static __declspec(nothrow) HRESULT CreateInstance(CAnimationController* pAnimationController, IUIAnimationVariableChangeHandler **ppHandler)
	{
		CAnimationVariableChangeHandler *pHandler = 0;
		HRESULT hr = CUIAnimationCallbackBase::CreateInstance(ppHandler, &pHandler);
		if ((((HRESULT)(hr)) >= 0))
		{
			pHandler->SetAnimationController (pAnimationController);
		}

		return hr;
	}

	
	
	
	
	void SetAnimationController(CAnimationController* pAnimationController)
	{
		m_pAnimationController = pAnimationController;
	}

	
	
	
	
	
	
	
	
	
	
	 virtual __declspec(nothrow) HRESULT __stdcall OnValueChanged
    (
          IUIAnimationStoryboard *storyboard,
          IUIAnimationVariable *variable,
          DOUBLE newValue,
          DOUBLE previousValue
    )
	{
		if (m_pAnimationController == 0)
		{
			__noop("An instance of OnValueChanged event handler has not been initialized.\n");
			return ((HRESULT)0x80004005L);
		}

		if (storyboard == 0 && variable != 0)
		{
			(void)variable->GetCurrentStoryboard(&storyboard);
		}

		CAnimationGroup* pGroup = 0;
		CAnimationBaseObject* pObject = 0;

		if (storyboard != 0)
		{
			pGroup = m_pAnimationController->FindAnimationGroup(storyboard);
			if (pGroup == 0)
			{
				__noop("Got OnValueChanged event for a storyboard, which does not belong to any Animation Group.\n");
				return ((HRESULT)0x80004005L);
			}

			pObject = pGroup->FindAnimationObject(variable);

			if (pObject == 0)
			{
				__noop("Got OnValueChanged event from an animation variable, which does not belong to any Animation Group.\n");
				return ((HRESULT)0x80004005L);
			}
		}
		else
		{
			m_pAnimationController->FindAnimationObject(variable, &pObject, &pGroup);
		}

		m_pAnimationController->OnAnimationValueChanged(pGroup, pObject, variable, newValue, previousValue);
		return ((HRESULT)0L);
	}
};









