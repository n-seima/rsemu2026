inline unsigned long
GetHashCode(BYTE* _lpString)
{
	int	iResult=0,iXOR=0,iCH=0,i=0;

	for (;_lpString[i];i++)
	{
		iCH		=	_lpString[i];

		if (iCH >= 'a' && iCH <= 'z')
			iCH	-=	('a'-'A');

		iResult	=	( ( iResult << 8 ) | iCH ) % 16777213UL; 
		iXOR		^=	iCH;
	}

	return iResult | (iXOR<<24);
}

inline unsigned long
GetHashCode(char* _lpString)
{
	return	GetHashCode((BYTE*) _lpString);
}

















































































