class	cRANDOM
{
private:
	DWORD	m_dwGen1,m_dwGen2,m_dwSeed;

public:
	BOOL	ready(DWORD _dwGen1,DWORD _dwSeed)
	{
		if	(_dwGen1	>=	0xffffffff/2)	return	0;
		if	(_dwSeed	>=	_dwGen1		)	return	0;

		m_dwGen1	=	_dwGen1;
		m_dwGen2	=	_dwGen1*2;
		m_dwSeed	=	_dwSeed;

		return	1;
	}

	inline	DWORD	random(DWORD _dwLimit)
	{
		m_dwSeed	=	((m_dwGen1*m_dwSeed)+m_dwGen2)%_dwLimit;

		return	m_dwSeed;
	}
};





template <class T>
class	cDen	
{
	T					*m_pList;
	T					*m_lpList;
	WORD				*m_pOrderingBuffer;
	int					m_iLimitCount;
	int					m_iCount,m_iRookie;

public:
						cDen()
						{
							m_pList				=	0;
							m_iLimitCount		=	0;
							m_iCount			=	0;
							m_iRookie			=	0;
							m_pOrderingBuffer	=	0;
						}

						~cDen()
						{
							close();
						}

	void				init(int _iCount,BOOL _bIsOrdering=0)
	{
		close();

		m_pList			=	new T [_iCount];
		m_lpList		=	m_pList;
		m_iLimitCount	=	_iCount;

		if (_bIsOrdering)
		{
			m_pOrderingBuffer=	new WORD [_iCount];

			memset(m_pOrderingBuffer,0xff,sizeof(WORD)*_iCount);
		}

		reset();
	}

	void				init(T *_lpList,int _iCount,BOOL _bIsOrdering=0)
	{
		close();

		m_lpList		=	_lpList;
		m_iLimitCount	=	_iCount;

		if (_bIsOrdering)
		{
			m_pOrderingBuffer=	new WORD [_iCount];

			memset(m_pOrderingBuffer,0xff,sizeof(WORD)*_iCount);
		}

		reset();
	}

	inline	void		reset()
	{
		m_iCount		=	0;
		m_iRookie		=	0;
		
		if	(m_lpList)
			for (int i=m_iLimitCount;i;)
			{
				--i;
				m_lpList[i].reset();
			}
	}

	void				close()
	{
		reset();
		
		if (m_pList) {delete [] m_pList ;m_pList=0;};
		if (m_pOrderingBuffer) {delete [] m_pOrderingBuffer ;m_pOrderingBuffer=0;};

		m_lpList		=	0;
	}

	inline	T*			get(int _iSerial)
	{
		if	(_iSerial						>=	m_iLimitCount	)
			return	0;
		if	(m_lpList[_iSerial].m_wSerial	==	0xffff			)
			return	0;

		return	&m_lpList[_iSerial];
	}
	inline	T*			getByOrdering(int _iIndex)	
	{
		if (_iIndex	>=	m_iCount	||	_iIndex	<	0)
			return	0;

		return	&m_lpList[m_pOrderingBuffer[_iIndex]];
	}
	inline	T*			notCheckedget(int _iIndex)	
	{
		return	&m_lpList[_iIndex];
	}
	inline	T*			getList()			{return	m_lpList;}
	inline	int			getCount()			{return	m_iCount;}
	inline	int			getMaxCount()		{return	m_iLimitCount;}
	inline	BOOL		isFull()
	{
		if (getCount() == getMaxCount())
			return	1;

		return	0;
	}
	int					add(T* _lpData)
	{
		if (m_iCount	>=	m_iLimitCount)
			return	0xffff;

		int	iIndex	=	m_iRookie;

		m_lpList[m_iRookie].copy(_lpData);
		m_lpList[m_iRookie].m_wSerial	=	m_iRookie;

		if (m_pOrderingBuffer)
			m_pOrderingBuffer[m_iCount]	=	m_iRookie;

		m_iCount++;

		for (int i=m_iRookie+1;i<m_iLimitCount;i++)
			if (m_lpList[i].m_wSerial	==	0xffff)
			{
				m_iRookie	=	i;

				return	iIndex;
			}

		return	iIndex;
	}

	inline	T*			getRookie(int *_lpSerial)
	{
		if	(m_iCount	>=	m_iLimitCount)
			return	0;

		*_lpSerial	=	m_iRookie;

		return	&m_lpList[m_iRookie];
	}

	inline	int			getRookieSerial()
	{
		if	(m_iCount	>=	m_iLimitCount)
			return	0xffff;

		return	m_iRookie;
	}

	inline	void		increaseCount()
	{
		if	(m_lpList[m_iRookie].m_wSerial	==	0xffff)
			return;

		if	(m_pOrderingBuffer)
			m_pOrderingBuffer[m_iCount]	=	m_iRookie;

		m_iCount++;

		for (int i=m_iRookie+1;i<m_iLimitCount;i++)
			if (m_lpList[i].m_wSerial	==	0xffff)
			{
				m_iRookie	=	i;

				break;
			}
	}

	BOOL				remove(int _iIndex)
	{
		if	(_iIndex	<	0	||	_iIndex	>=	m_iLimitCount	||	m_lpList	==	0	||	m_lpList[_iIndex].m_wSerial	==	0xffff)
			return	0;

		m_lpList[_iIndex].reset();

		if (m_pOrderingBuffer)
			for (int i=0;i<m_iCount;i++)
				if	(m_pOrderingBuffer[i]	==	_iIndex)
				{
					m_pOrderingBuffer[i]	=	m_pOrderingBuffer[m_iCount-1];
					break;
				}

		if (_iIndex	<	m_iRookie)
			m_iRookie	=	_iIndex;

		m_iCount--;

		return	1;
	}

	BOOL				replace(int _iSerial,T *_lpData)	
	{
		BOOL	bIsExist	=	0;

		if	(m_lpList[_iSerial].m_wSerial	!=	0xffff)
			bIsExist	=	1;

		m_lpList[_iSerial].copy(_lpData);
		m_lpList[_iSerial].m_wSerial	=	_iSerial;

		if	(bIsExist	==	0)
		{
			if	(m_pOrderingBuffer)
				m_pOrderingBuffer[m_iCount]	=	_iSerial;
			
			m_iCount++;

			for (int i=m_iRookie;i<m_iLimitCount;i++)
				if (m_lpList[i].m_wSerial	==	0xffff)
				{
					m_iRookie	=	i;

					return	1;
				}
		}

		return	1;
	}

	BOOL				insert(int _iSerial,T *_lpData)
	{
		if	(m_lpList[_iSerial].m_wSerial	!=	0xffff)
			return	0;

		m_lpList[_iSerial].copy(_lpData);
		m_lpList[_iSerial].m_wSerial	=	_iSerial;

		if (m_pOrderingBuffer)
			m_pOrderingBuffer[m_iCount]	=	_iSerial;

		m_iCount++;

		for (int i=m_iRookie;i<m_iLimitCount;i++)
			if (m_lpList[i].m_wSerial	==	0xffff)
			{
				m_iRookie	=	i;

				return	1;
			}

		return	1;
	}

	void			rebuild()
	{
		int	i;

		m_iRookie	=	-1;
		m_iCount	=	0;

		for (i=0;i<m_iLimitCount;i++)
		{
			if (m_lpList[i].m_wSerial	==	0xffff)
			{
				if	(m_iRookie	==	-1)
					m_iRookie	=	i;

				continue;
			}

			m_iCount++;
		}

		if (m_pOrderingBuffer)
		{
			m_iCount	=	0;

			for (i=0;i<m_iLimitCount;i++)
			{
				if (m_lpList[i].m_wSerial	==	0xffff)
					continue;

				m_pOrderingBuffer[m_iCount++]	=	i;
			}
		}
	}
};





