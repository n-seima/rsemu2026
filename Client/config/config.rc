CONFIG_I DIALOGEX 0, 0, 303, 183
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION
EXSTYLE WS_EX_APPWINDOW
CAPTION "Red Stone system setting"
FONT 9, "Arial", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,100,163,50,17
    PUSHBUTTON      "Exit",IDCANCEL,152,163,50,17
    GROUPBOX        "Graphic setting",IDC_STATIC,6,7,290,70
    GROUPBOX        "option",IDC_STATIC,6,79,290,82
    CONTROL         "1. Direct Draw use(basic)",IDC_USE_DIRECT_DRAW,"Button",
                    BS_AUTORADIOBUTTON | BS_MULTILINE | BS_FLAT,12,21,95,9
    CONTROL         "2. Direct Draw use(pro)",IDC_USE_AGP,"Button",
                    BS_AUTORADIOBUTTON | BS_MULTILINE | BS_FLAT,12,32,93,10
    CONTROL         "3. DIB use",IDC_USE_DIB,"Button",BS_AUTORADIOBUTTON | 
                    BS_MULTILINE | BS_FLAT,12,43,47,10
    LTEXT           "- When process is too slow, set mode number 3. However, update of graphic driver is more recommended.",
                    IDC_STATIC,109,20,175,27
    CONTROL         "Music on",IDC_MUSIC_ON,"Button",BS_AUTOCHECKBOX | 
                    BS_FLAT | WS_TABSTOP,12,91,46,10
    CONTROL         "Sound on",IDC_SOUND_ON,"Button",BS_AUTOCHECKBOX | 
                    BS_FLAT | WS_TABSTOP,12,105,53,10
    LTEXT           "- If system is down whenever hitting monster or being hit by monster, it is because you didn't install sound driver. Update to the latest version of driver is recommended.",
                    IDC_STATIC,109,88,175,33
    CONTROL         "Exclusive mode",IDC_EXCLUSIVE_MODE,"Button",
                    BS_AUTOCHECKBOX | BS_FLAT,12,118,62,10
    LTEXT           "- When exclusive mode is set, the efficiency of other windows could be lowered. Exclusive mode setting is not encouraged except when game process is abnormally slow.",
                    IDC_STATIC,109,126,175,32
    CONTROL         "Slim mode",IDC_SLIM_MEMORY_MODE,"Button",
                    BS_AUTOCHECKBOX | BS_FLAT,12,54,61,8
    CONTROL         "Window Mode",IDC_WINDOW_MODE,"Button",BS_AUTOCHECKBOX | 
                    BS_FLAT,12,64,61,9
END

