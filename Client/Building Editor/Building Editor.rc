BUILDINGEDITOR MENU DISCARDABLE 
BEGIN
    POPUP "화일"
    BEGIN
        MENUITEM "새로운 화일",                 IDM_NEW
        MENUITEM SEPARATOR
        MENUITEM "불러오기",                    IDM_LOAD
        MENUITEM "저장하기",                    IDM_SAVE
        MENUITEM "다른이름으로 저장",           IDM_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "이미지 부르기(pcs,bmp,tga)",  IDM_LOADBMP
        MENUITEM "그림자 부르기(pcx,bmp,tga)",  IDM_LOADSHADOW
        MENUITEM SEPARATOR
        MENUITEM "끝내기",                      IDM_EXIT
    END
    POPUP "건물 모양"
    BEGIN
        MENUITEM "정지",                        ID_MENUSTOP
    END
    POPUP "덧 붙일 모양"
    BEGIN
        MENUITEM "일반 에니메이션",             IDM_ADD_ANM
        MENUITEM "효과 에니메이션",             IDM_ADD_ANM_EFFECT
        MENUITEM "닫힌 문",                     IDM_CLOSED_DOOR
        MENUITEM "문 열림",                     IDM_OPEN_DOOR
    END
END


