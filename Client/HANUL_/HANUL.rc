HANUL MENU DISCARDABLE 
BEGIN
    POPUP "화일"
    BEGIN
        MENUITEM "새로운 화일",                 IDM_NEW
        MENUITEM SEPARATOR
        MENUITEM "불러오기",                    IDM_LOAD
        MENUITEM "저장하기",                    IDM_SAVE
        MENUITEM "다른이름으로 저장",           IDM_SAVEAS
        MENUITEM "코드 스프라이트로 저장",      IDM_SAVE_CODE_SPRITE
        MENUITEM SEPARATOR
        POPUP "덧붙이는 데이터"
        BEGIN
            MENUITEM "캐릭터 데이터",               IDM_LOADCHARACTER
            MENUITEM "마법 효과 데이터",            IDM_LOADEFFECT
            MENUITEM "무기 데이터",                 IDM_LOADWEAPON
            MENUITEM "무기 효과 데이터",            IDM_LOADWEAPONEFFECT
            MENUITEM "방패 데이터",                 IDM_LOADSHIELD
            MENUITEM "방패효과 데이터",             IDM_LOADSHIELDEFFECT
        END
        MENUITEM "Import 에니메이션",           IDM_IMPORT
        MENUITEM "Import 에니메이션(for 앉기)", IDM_IMPORT2
        MENUITEM SEPARATOR
        MENUITEM "이미지 불러오기(pcx,bmp,tga)", IDM_LOADBMP
        MENUITEM "그림자 불러오기(pcx,bmp,tga)", IDM_LOADSHADOW
        MENUITEM "그림자 이미지 같이 불러오기", IDM_LOAD_SET
        MENUITEM SEPARATOR
        MENUITEM "끝내기",                      IDM_EXIT
    END
    POPUP "직업"
    BEGIN
        MENUITEM "장비 레이어 정보 불러오기",   IDM_LOAD_PLAYER_PARTS_LAYER
        MENUITEM "장비 레이어 정보 저장하기",   IDM_SAVE_PLAYER_PARTS_LAYER
        MENUITEM SEPARATOR
        MENUITEM "플레이어 장비 아님",          ID_JOB_NONE, CHECKED
        MENUITEM "견습 기사",                   ID_JOB_KNIGHT
        MENUITEM "전사",                        ID_JOB_WARRIOR
        MENUITEM "마법사",                      ID_JOB_WIZARD
        MENUITEM "늑대 인간",                   ID_JOB_WEREWOLF
        MENUITEM "사제",                        ID_JOB_PRIEST
        MENUITEM "타락 천사",                   ID_JOB_FALLEN_ANGEL
        MENUITEM "마법 궁수",                   ID_JOB_MAGIC_ARCHER
        MENUITEM "마법 창병",                   ID_JOB_MAGIC_LANCER
        MENUITEM "도둑",                        ID_JOB_ROGUE
        MENUITEM "무도가",                      ID_JOB_FIGHTER, GRAYED
        MENUITEM "공주",                        ID_JOB_PRINCESS
        MENUITEM "마법 소녀",                   ID_JOB_MAGICAL_GIRL
        MENUITEM "조련사",                      ID_JOB_TAMER
        MENUITEM "소환사",                      ID_JOB_SUMMONER, GRAYED
        MENUITEM "강신술사",                    ID_JOB_NECROMANCER
        MENUITEM "악마",                        ID_JOB_DEVIL
    END
    POPUP "플레이어 파트 이미지 로딩"
    BEGIN
        MENUITEM "이미지",                      IDM_LOAD_PARTS_IMAGE
        MENUITEM SEPARATOR
        MENUITEM "그림자",                      IDM_LOAD_SHADOW
    END
    POPUP "툴"
    BEGIN
        MENUITEM "화일 컨버트",                 IDM_RESAVE
        MENUITEM "모든 스프라이트 중심 리셋",   IDM_RESET_POS
        MENUITEM "Export",                      IDC_EXPORT
    END
END


