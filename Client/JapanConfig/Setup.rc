/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

CONFIG DIALOGEX 0, 0, 303, 200
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION
EXSTYLE WS_EX_APPWINDOW
CAPTION "RED STONE システム設定"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    DEFPUSHBUTTON   "確認",IDOK,100,180,50,17
    PUSHBUTTON      "終了",IDCANCEL,152,180,50,17
    GROUPBOX        "グラフィック設定",IDC_STATIC,6,7,290,93
    GROUPBOX        "オプション",IDC_STATIC,6,101,290,76
    CONTROL         "1. Direct Draw 使用(推奨)",IDC_USE_DIRECT_DRAW,"Button",
                    BS_AUTORADIOBUTTON | BS_MULTILINE | BS_FLAT,12,21,92,9
    CONTROL         "2. Direct Draw 使用(高級)",IDC_USE_AGP,"Button",
                    BS_AUTORADIOBUTTON | BS_MULTILINE | BS_FLAT,12,32,93,10
    CONTROL         "3. DIB 使用",IDC_USE_DIB,"Button",BS_AUTORADIOBUTTON | 
                    BS_MULTILINE | BS_FLAT,12,43,47,10
    LTEXT           "※ ゲームが遅いと感じた場合は、3番の「DIB 使用」を試してください。 \nまた、グラフィックドライバが最新のものになっていない場合は、更新する事をお勧めいたします。",
                    IDC_STATIC,109,20,175,41
    CONTROL         "サウンド オン",IDC_MUSIC_ON,"Button",BS_AUTOCHECKBOX | 
                    BS_FLAT | WS_TABSTOP,12,115,81,10
    CONTROL         "効果音 オン",IDC_SOUND_ON,"Button",BS_AUTOCHECKBOX | 
                    BS_FLAT | WS_TABSTOP,12,129,53,10
    LTEXT           "※ 戦闘中に停止してしまう場合は、サウンドドライバが原因であることが考えられます。 \n最新のものに更新する事をお勧めいたします。",
                    IDC_STATIC,109,110,175,26
    CONTROL         "独占モード",IDC_EXCLUSIVE_MODE,"Button",BS_AUTOCHECKBOX | 
                    BS_FLAT,12,142,46,10
    LTEXT           "※ 独占モードを設定すると、RED STONEをプレイしている間は他のプログラムの効率が低下する可能性があります。 \nゲームが極端に遅い場合以外での設定はお勧めいたしません。",
                    IDC_STATIC,109,138,175,35
    CONTROL         "スリープモード",IDC_SLIM_MEMORY_MODE,"Button",
                    BS_AUTOCHECKBOX | BS_FLAT,12,56,61,11
    LTEXT           "※ スリープモードを設定すると、ゲーム開始の速度が速くなります。ただし、ゲーム中は常に通信接続が行われている関係上、状況によっては、スリープモードに設定していても遅くなる場合があります。",
                    IDC_STATIC,109,62,176,34
    CONTROL         "ウィンドウモード",IDC_WINDOW_MODE,"Button",
                    BS_AUTOCHECKBOX | BS_FLAT,12,68,61,11
    CONTROL         "解像度（1024×768）",IDC_1024X768,"Button",
                    BS_AUTOCHECKBOX | BS_FLAT,12,82,87,11
END

#endif    // Japanese resources
