IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SMSSender 정보"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "SMSSender, 버전 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2009",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "확인",IDOK,113,41,50,14,WS_GROUP
END

IDD_SMSSENDER_DIALOG DIALOGEX 0, 0, 255, 330
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
EXSTYLE WS_EX_APPWINDOW
CAPTION "RS SMS Alarm"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    EDITTEXT        IDC_NEW_PHONE_NUMBER,23,292,68,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_NEW_NAME,111,292,39,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Exit",IDC_BUTTON1,102,314,50,14
    PUSHBUTTON      "Test",IDC_TEST,160,315,50,14,NOT WS_VISIBLE | WS_DISABLED
    PUSHBUTTON      "[터미널 접속 했습니다. 문제 확인 시작합니다.]\n라는 메시지 전송. 먼저 전송 번호가 맞는지 확인해 주세요.",IDC_CHECK_NOW,2,88,249,21,BS_LEFT | BS_MULTILINE
    PUSHBUTTON      "[문제 해결 했습니다.] 라는 메시지 전송\n먼저 전송 번호가 맞는지 확인해 주세요.",IDC_REPAIR_PROBLEM,2,111,249,21,BS_LEFT | BS_MULTILINE
    CONTROL         "",IDC_LIST1,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,7,191,242,98
    LTEXT           "전송 번호",IDC_STATIC,2,76,31,8
    COMBOBOX        IDC_SENDER,34,74,218,131,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "번호",IDC_STATIC,7,294,15,8
    LTEXT           "이름",IDC_STATIC,96,294,15,8
    PUSHBUTTON      "추가",IDC_NEW_MEMBER,209,291,20,14
    PUSHBUTTON      "제거",IDC_REMOVE_MEMBER,231,291,20,14
    GROUPBOX        "전송 목록",IDC_STATIC,2,180,251,132
    LTEXT           "구분",IDC_STATIC,153,294,15,8
    COMBOBOX        IDC_TYPE,168,292,38,131,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "- 로그 파일 : c:/_rsLog/deathLog.txt 라이프 사인관련 메시지 로그 파일",IDC_STATIC,4,35,223,8
    LTEXT           "- 라이프 사인 파일 : c:/_rsLog/deathSign.txt 데쓰 사인입니다. 이 파일의 유무로 이상 유무를 판단합니다. 이 파일에는 가장 최근에 문제에 대한 SMS 전송용 문자가 저장됩니다.",IDC_STATIC,5,7,239,27
    LTEXT           "- 수정 진행 : c:/_rsLog/nowChecking.dat 문제 해결하는 동안임을 표시 하는 파일. 이 파일이 있으면 문제가 생겨도 무시합니다.",IDC_STATIC,5,47,239,17
    PUSHBUTTON      "메시지 전송",IDC_SEND_CUSTOM_MSG,208,149,44,25,BS_MULTILINE
    EDITTEXT        IDC_CUSTOM_MSG,5,143,199,36,ES_MULTILINE
    LTEXT           "- 글자 수",IDC_CUSTOM_MSG_LENGTH,6,134,49,8
END


