# ============================
# ビルド成果物ディレクトリを無視
# ============================

*___Win32_Debug*/
*___Win32_Release*/
*___Win32_forJapan*/
*___Win32_forJapanOperator*/
*___Win32_Debug_FOR_JAPAN*/
*___Win32_Release_FOR_JAPAN*/
*___Win32_Debug_FOR_CHINA*/
*___Win32_Release_FOR_CHINA*/

# 中の必要ファイルを追跡対象にしたい場合は再スキャン許可（ただし、意図的に入れるときのみ有効）
