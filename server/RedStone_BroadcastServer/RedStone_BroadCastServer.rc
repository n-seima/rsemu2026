    CONTROL         "",IDC_STATIC,"Static",SS_BLACKFRAME,7,202,276,1
    CONTROL         "",IDC_STATIC,"Static",SS_BLACKFRAME,7,320,276,1
    LTEXT           "Processing Data",IDC_STATIC,7,206,57,11
    LTEXT           "User Data :",IDC_STATIC,7,226,41,10
    EDITTEXT        IDC_USERDATATEXT,48,224,235,12,ES_AUTOHSCROLL | 
                    ES_READONLY
    LTEXT           "()",IDC_INWORLDNAME,69,205,207,11
    EDITTEXT        IDC_GUILD_MEMBER_LIST_UPDATE_PERIOD,218,56,35,12,
                    ES_AUTOHSCROLL
    PUSHBUTTON      "Apply",IDC_GUILD_MEMBER_LIST_UPDATE_APPLY,257,55,21,14
    LTEXT           "UpdatePeriod",IDC_STATIC,217,41,43,9
    PUSHBUTTON      "Change",IDC_IMMEDIATELY_UPDATE_CHANGE,250,91,29,14
    LTEXT           "ImmediatelyUpdate",IDC_STATIC,217,77,63,9
    GROUPBOX        "GuildList",IDC_STATIC,214,27,67,84
    EDITTEXT        IDC_IMMEDIATELY_UPDATE,217,92,29,12,ES_AUTOHSCROLL | 
