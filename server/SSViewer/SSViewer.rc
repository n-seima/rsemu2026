    LTEXT           "Copyright (C) 2007",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "확인",IDOK,178,7,50,14,WS_GROUP
END

IDD_SSVIEWER_DIALOG DIALOGEX 0, 0, 123, 37
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION
EXSTYLE WS_EX_APPWINDOW
CAPTION "SSViewer"
FONT 9, "굴림", 0, 0, 0x1
BEGIN
    LTEXT           "RSOnline Server State Viewer",IDC_STATIC,16,14,97,8
    GROUPBOX        "",IDC_STATIC,7,2,109,28
END

IDD_DIALOG_HISTORY DIALOG DISCARDABLE  0, 0, 302, 367
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "History"
FONT 9, "돋움"
BEGIN
    PUSHBUTTON      "Close",IDC_BUTTON_CLOSE,232,335,55,16
    CONTROL         "List1",IDC_LIST_DATA,"SysListView32",LVS_REPORT | 
                    WS_BORDER | WS_TABSTOP,14,13,275,314
    COMBOBOX        IDC_COMBO_YEAR,133,337,52,142,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_COMBO_MONTH,192,337,32,144,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "",IDC_STATIC,7,2,288,358
END

IDD_DLG_TIMEINPUT DIALOG DISCARDABLE  0, 0, 121, 28
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
